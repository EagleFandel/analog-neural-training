# 包含文档
include README.md
include LICENSE
include requirements.txt
include CHANGELOG.md
include GETTING_STARTED.md
include QUICKSTART.md
include CONTRIBUTING.md
include PROJECT_STRUCTURE.md

# 包含文档目录
recursive-include docs *.md
recursive-include reports *.md *.pdf

# 包含示例
recursive-include examples *.py
recursive-include experiments *.py

# 包含配置文件
include setup.py
include pyproject.toml
recursive-include config *.yaml *.yml *.json

# 包含分析工具
recursive-include analysis *.py

# 排除不需要的文件
global-exclude *.pyc
global-exclude *.pyo
global-exclude *__pycache__*
global-exclude .DS_Store
global-exclude .git*
global-exclude *.so
global-exclude *.egg-info
global-exclude test_*.py
global-exclude debug_*.py
global-exclude *.pdf
prune .venv
prune build
prune dist
prune .github
